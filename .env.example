# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Your test Discord server ID (enable Developer Mode, then Copy Server ID)
DISCORD_GUILD_ID=

# Optional. If set, only members with this role may use server-control commands.
# Otherwise, popdog requires Discord's Manage Server permission.
DISCORD_ADMIN_ROLE_ID=

# ReHLDS game-server query address
GOLDSRC_HOST=127.0.0.1
GOLDSRC_PORT=27015
GOLDSRC_QUERY_TIMEOUT_MS=2500

# Must match rcon_password in cstrike/server.cfg
GOLDSRC_RCON_PASSWORD=
GOLDSRC_RCON_TIMEOUT_MS=2500
