# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Your test Discord server ID (enable Developer Mode, then Copy Server ID)
DISCORD_GUILD_ID=

# Optional. If set, only members with this role may use server-control commands.
# Otherwise, popdog requires Discord's Manage Server permission.
DISCORD_ADMIN_ROLE_ID=

# ReHLDS game-server query address
GOLDSRC_HOST=127.0.0.1
GOLDSRC_PORT=27015
GOLDSRC_QUERY_TIMEOUT_MS=2500

# Must match rcon_password in cstrike/server.cfg
GOLDSRC_RCON_PASSWORD=
GOLDSRC_RCON_TIMEOUT_MS=2500

# UDP listener for ReHLDS logaddress_add packets. LOG_ALLOWED_HOST defaults to
# GOLDSRC_HOST. Set LOG_DEBUG=true to print received events to popdog's stdout.
GOLDSRC_LOG_BIND_HOST=0.0.0.0
GOLDSRC_LOG_PORT=27500
GOLDSRC_LOG_ALLOWED_HOST=
GOLDSRC_LOG_DEBUG=false

# Popdog registers this destination through RCON during startup. When omitted,
# a specific bind host such as 127.0.0.1 is used. It is required with 0.0.0.0.
GOLDSRC_LOG_AUTO_CONFIGURE=true
GOLDSRC_LOG_ADVERTISE_HOST=
GOLDSRC_LOG_ADVERTISE_PORT=27500

# Temporary laptop testing only: keep a stateful UDP NAT/firewall mapping open
# to the ReHLDS game endpoint. Production on the game host does not need this.
GOLDSRC_LOG_NAT_KEEPALIVE=false
GOLDSRC_LOG_KEEPALIVE_INTERVAL_MS=15000

# Comma-separated Steam2 IDs allowed to run in-game commands such as .lo3.
GOLDSRC_COMMAND_STEAM_IDS=

# Persisted MR12 match tracking
MATCH_MAX_ROUNDS_PER_HALF=12
MATCH_STATE_PATH=./data/match-state.json

# HLTV uses adminpassword (not the game server's rcon_password).
HLTV_HOST=127.0.0.1
HLTV_PORT=27020
HLTV_ADMIN_PASSWORD=
HLTV_RCON_TIMEOUT_MS=2500
HLTV_RECORDING_PREFIX=match
HLTV_MIN_FREE_GIB=5
HLTV_MIN_RECORDING_PLAYERS=3
HLTV_LOW_PLAYER_GRACE_SECONDS=300
HLTV_GUARD_INTERVAL_SECONDS=60

# Local path whose filesystem contains the HLTV demos. Defaults to the root of
# the drive running popdog (/ on Linux/macOS, or the current drive on Windows).
HLTV_DISK_PATH=/
